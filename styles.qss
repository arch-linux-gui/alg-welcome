/* Qt Stylesheet for Welcome to ALG Application.
   A handful of color values below are @TOKEN@ placeholders, substituted at load time by
   WelcomeWindow::applyStylesheet() based on the system's current light/dark state (see
   src/dialogs/AppPalette.h) - everything else (layout, spacing, the rules with literal colors
   below) is the same regardless of theme. */

/* Labels */
QLabel {
    font-size: 16px;
    font-weight: normal;
}

/* Buttons */
QPushButton {
    font-size: 14px;
    border-radius: 6px;
    padding: 5px 10px;
    outline: none;
    border: 1px solid @btnBorder@;
    background-color: @btnBg@;
    color: @btnText@;
}

QPushButton:hover {
    background-color: @btnHoverBg@;
    border: 1px solid @btnHoverBorder@;
}

QPushButton:pressed {
    background-color: @btnPressedBg@;
    border: 1px solid @btnPressedBorder@;
}

QPushButton:disabled {
    background-color: @btnDisabledBg@;
    color: @btnDisabledText@;
    border: 1px solid @btnDisabledBorder@;
}

QPushButton:focus {
    outline: none;
    border: 1px solid #0c8b5bb2;
}

/* Header */
QLabel#header {
    font-size: 20px;
    font-weight: bold;
}

QLabel#subtitle {
    font-size: 12px;
    color: @subtitleText@;
}

/* Section labels ("Basic Utilities", "Project Information") */
QLabel#sectionLabel {
    font-size: 12px;
    color: @sectionLabelText@;
}

/* Sub-page header bar (Mirrorlist / Theme / About) is styled directly in
   src/dialogs/PageChrome.h so it renders consistently even on pages, like ThemePage, that set
   their own local stylesheet. */

/* Primary (call-to-action) buttons: Mirrorlist Update, Theme Apply */
QPushButton#primaryButton {
    background-color: #3d7eff;
    color: #ffffff;
    border: none;
}

QPushButton#primaryButton:hover {
    background-color: #5a90ff;
    border: none;
}

QPushButton#primaryButton:disabled {
    background-color: #3a3d42;
    color: #7a8087;
    border: none;
}

/* Home page collapsible activity log */
QPushButton#logToggleButton {
    background: none;
    border: none;
    color: @logToggleText@;
    font-size: 12px;
    text-align: left;
    padding: 2px 0;
}

QPlainTextEdit#logView {
    background-color: @logViewBg@;
    border: 1px solid @logViewBorder@;
    border-radius: 6px;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    color: @logViewText@;
}

/* Toast notification */
QLabel#toast {
    background-color: @toastBg@;
    color: @toastText@;
    font-size: 12px;
    padding: 8px 14px;
    border-radius: 6px;
}

/* CheckBox as Switch */
QCheckBox {
    spacing: 10px;
}

QCheckBox::indicator {
    width: 48px;
    height: 24px;
}

QCheckBox::indicator:unchecked {
    image: url(assets:switch_off.svg);
}

QCheckBox::indicator:checked {
    image: url(assets:switch_on.svg);
}


/* Frame
QFrame {
    border: 0px solid #ddd;
    border-radius: 4px;
    padding: 5px;
} */

/* ComboBox */
QComboBox {
    padding: 5px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background-color: #2c2b36;
}

QComboBox:hover {
    border: 1px solid #999;
}

QComboBox::drop-down {
    border: none;
}

/* SpinBox */
QSpinBox {
    padding: 2px;
    border: 0px solid #ccc;
    border-radius: 2px;
    background-color: 2a2a2a;
}

QSpinBox:hover {
    border: 1px solid #999;
}

/* TreeView for mirror list */
QTreeView {
    border: 1px solid #ccc;
    border-radius: 4px;
    background-color: white;
    alternate-background-color: #f5f5f5;
}

QTreeView::item {
    padding: 5px;
    color: black;
}

QTreeView::item:selected {
    background-color: #2c2b36;
    color: white;
}

QTreeView::item:hover {
    background-color: #e0e0e0;
}

/* Headers for TreeView */
QHeaderView::section {
    background-color: #f0f0f0;
    padding: 5px;
    border: 1px solid #ccc;
    font-weight: bold;
    color: black;
}

/* ScrollBar */
QScrollBar:vertical {
    border: none;
    background-color: #f0f0f0;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #ccc;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #999;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* GroupBox / Frame for sections */
QGroupBox {
    font-weight: bold;
    border: 1px solid #ccc;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
}